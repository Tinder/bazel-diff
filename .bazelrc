run -c opt --show_loading_progress=false --show_progress=false --ui_event_filters=error
run:verbose -c dbg --show_loading_progress=true --show_progress=true --ui_event_filters=info,error,debug
common --enable_platform_specific_config

common:windows --host_platform=//platforms:windows_msvc
# Keep Windows exec paths under MAX_PATH (rules_rs#270): name output
# directories "win-..." instead of "x64_windows-...".
common:windows --experimental_platform_in_output_dir
common:windows --experimental_override_name_platform_in_output_dir=//platforms:windows_msvc=win
# ring's build script needs generated headers in the legacy runfiles layout.
build:windows --legacy_external_runfiles

# Match Cargo.toml's release profile.
build:release -c opt
build:release --@rules_rust//rust/settings:lto=thin
build:release --@rules_rust//rust/settings:extra_rustc_flags=-Cstrip=symbols

# Statically linked Linux releases, also cross-compiled from macOS.
build:release-linux --config=release
build:release-linux --platforms=@rules_rs//rs/platforms:x86_64-unknown-linux-musl

build:release-linux-arm64 --config=release
build:release-linux-arm64 --platforms=@rules_rs//rs/platforms:aarch64-unknown-linux-musl

# Integration tests need bazel on PATH.
common --incompatible_strict_action_env
common --test_env=PATH

# Check selected first-party targets. CI checks all roots through
# //:rust_clippy_check and //:rust_format_check.
build --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build --output_groups=+clippy_checks

# Lint policy for every first-party Rust crate (the aspect skips external
# crates): clippy::pedantic, with warnings as errors. Cargo.toml [lints.clippy]
# mirrors this list for `cargo clippy`; keep the two in step. Setting any flag
# here replaces rules_rust's implicit -Dwarnings, so it comes first.
#
# Pedantic lints not adopted:
# - The doc lints: this is a CLI crate whose module API is not a stability
#   commitment (see src/lib.rs), so `# Errors`/`# Panics` sections and
#   `#[must_use]` on every accessor would be noise rather than a contract.
# - too_many_lines: the long functions are linear CLI and pipeline glue;
#   splitting them to satisfy a line count would not make them clearer.
# - similar_names / struct_excessive_bools: the names mirror Bazel's own
#   vocabulary and the bool-heavy structs are clap argument groups.
# - case_sensitive_file_extension_comparisons: Bazel labels and workspace
#   paths are case-sensitive, so the case-insensitive comparison the lint
#   proposes would change which files a rule is seen to own.
# - implicit_hasher: the target-type filters are only ever std `HashSet`s;
#   a `BuildHasher` parameter would be generality nobody uses.
build --@rules_rust//rust/settings:clippy_flag=-Dwarnings
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::pedantic
build --@rules_rust//rust/settings:clippy_flag=-Aclippy::missing_errors_doc
build --@rules_rust//rust/settings:clippy_flag=-Aclippy::missing_panics_doc
build --@rules_rust//rust/settings:clippy_flag=-Aclippy::must_use_candidate
build --@rules_rust//rust/settings:clippy_flag=-Aclippy::too_many_lines
build --@rules_rust//rust/settings:clippy_flag=-Aclippy::similar_names
build --@rules_rust//rust/settings:clippy_flag=-Aclippy::struct_excessive_bools
build --@rules_rust//rust/settings:clippy_flag=-Aclippy::case_sensitive_file_extension_comparisons
build --@rules_rust//rust/settings:clippy_flag=-Aclippy::implicit_hasher
build --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
build --output_groups=+rustfmt_checks

# Merge LCOV reports and enforce the per-target coverage thresholds.
coverage --coverage_output_generator=//tools/coverage:lcov_merger

# Optional longer timeout for local nested-Bazel integration tests.
test:no-test-timeouts --test_timeout=21600

# CI writes a JSON build event file so a failed job can print the stderr of
# failed actions and the test.log of failed tests (tools/report_bazel_failures.py).
# The relative path resolves against the workspace; bazel-* is gitignored.
common:ci --build_event_json_file=bazel-bep.json
common:ci --build_event_json_file_path_conversion=false
