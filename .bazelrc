run -c opt --show_loading_progress=false --show_progress=false --ui_event_filters=error
run:verbose -c dbg --show_loading_progress=true --show_progress=true --ui_event_filters=info,error,debug
common --enable_platform_specific_config

common:windows --host_platform=//platforms:windows_msvc
# ring's build script needs generated headers in the legacy runfiles layout.
build:windows --legacy_external_runfiles

# Match Cargo.toml's release profile.
build:release -c opt
build:release --@rules_rust//rust/settings:lto=thin
build:release --@rules_rust//rust/settings:extra_rustc_flags=-Cstrip=symbols

# Statically linked Linux releases, also cross-compiled from macOS.
build:release-linux --config=release
build:release-linux --platforms=@rules_rs//rs/platforms:x86_64-unknown-linux-musl

build:release-linux-arm64 --config=release
build:release-linux-arm64 --platforms=@rules_rs//rs/platforms:aarch64-unknown-linux-musl

# Integration tests need bazel on PATH.
common --incompatible_strict_action_env
common --test_env=PATH

# Check selected first-party targets. CI checks all roots through
# //:rust_clippy_check and //:rust_format_check.
build --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build --output_groups=+clippy_checks
build --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
build --output_groups=+rustfmt_checks

# Merge LCOV reports and enforce the per-target coverage thresholds.
coverage --coverage_output_generator=//tools/coverage:lcov_merger

# Optional longer timeout for local nested-Bazel integration tests.
test:no-test-timeouts --test_timeout=21600
