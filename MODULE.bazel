module(
    name = "bazel-diff",
    version = "50.0.0",
    bazel_compatibility = [">=8.5.0"],
)

bazel_dep(name = "aspect_rules_lint", version = "2.1.0", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2", dev_dependency = True)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_license", version = "1.0.0")

# build.rs uses protoc to compile rust/proto/*.proto.
bazel_dep(name = "protobuf", version = "33.4")

bazel_dep(name = "rules_python", version = "1.8.4", dev_dependency = True)
bazel_dep(name = "rules_go", version = "0.62.0", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(version = "1.23.1")

# llvm 0.8.20+ adds hermetic Windows MSVC toolchains, which fail on a Windows
# MSVC exec host (rules_rs#271, hermetic-llvm#809). 0.8.19 has none, so Windows
# builds use the locally installed Visual Studio toolchain.
bazel_dep(name = "llvm", version = "0.8.19")
bazel_dep(name = "rules_rs", version = "0.0.112")
single_version_override(
    module_name = "rules_rs",
    patch_strip = 1,
    patches = ["//patches:rules_rs_package_name.patch"],
)

# LLVM 22.1.8 reads Rust 1.90's coverage profiles.
llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "22.1.8")
use_repo(llvm, "llvm-project")

# rules_rs provides the patched rules_rust lint rules and build settings.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

# Keep these repo names short: they appear in Windows exec paths, which must
# stay under MAX_PATH (rules_rs#270). The bd_ prefix avoids clashing with a
# consumer's own rules_rs toolchain or crate repos.
rust = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust.toolchain(
    name = "bd_rust",
    edition = "2021",
    version = "1.90.0",
)
use_repo(rust, "bd_rust")

register_toolchains(
    "@bd_rust//...",
    "@llvm//toolchain:all",
)

# CI selects this toolchain explicitly to check Cargo.toml's rust-version.
msrv = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains", dev_dependency = True)
msrv.toolchain(
    name = "bd_msrv",
    edition = "2021",
    version = "1.85.0",
)
use_repo(msrv, "bd_msrv")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "bd_crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
)
use_repo(crate, "bd_crates")
