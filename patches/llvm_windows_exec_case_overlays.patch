+# The SDK spells its file names in mixed case. These overlays let a case-sensitive exec file system resolve them.
+# A toolchain that runs on Windows leaves them out: its file system is case-insensitive, and the overlays are
+# built with `//tools/case_insensitive_vfs`, which that same toolchain would compile, so they form a cycle.
 cc_args_list(
+    name = "case_overlays",
+    args = ["sdk_header_case_overlay"] + select({
+        "//toolchain:runtimes_none": [],
+        "//conditions:default": ["sdk_library_case_overlay"],
+    }),
+    visibility = ["//visibility:public"],
+)
+
+cc_args_list(
     name = "normalized_default_libs",
     args = [
         "sdk_library_search_paths",
