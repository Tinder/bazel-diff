module(name = "extension_spokes_through_owner_test")

bazel_dep(name = "ext")
local_path_override(module_name = "ext", path = "ext")

# Module `ext`'s extension generates a hub `@crates` and one spoke per entry of
# versions.json; the spokes' targets use a rule `ext` defines. See external.rs.
crates = use_extension("@ext//:crates.bzl", "crates")
crates.lock(file = "//:versions.json")
use_repo(crates, "crates")
