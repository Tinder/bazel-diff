load("@ext//:defs.bzl", "tool")

constraint_setting(name = "mode")

constraint_value(name = "alternate", constraint_setting = ":mode")

platform(
    name = "platform",
    constraint_values = [":alternate"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "other_runtime",
    define_values = {"runtime": "other"},
)

# The alternative SDK requires a separate installation.
tool(
    name = "impl",
    runtime = select({
        ":other_runtime": "@bazel_tools//tools/unavailable_test_sdk:installation",
        "//conditions:default": ":version.txt",
    }),
)

toolchain(
    name = "registration",
    target_compatible_with = [":alternate"],
    toolchain = ":impl",
    toolchain_type = "@ext//:toolchain_type",
    visibility = ["//visibility:public"],
)
