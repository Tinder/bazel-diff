exports_files(["value.txt"])

genrule(
    name = "consumer",
    srcs = ["@bridge//:mirror.txt"],
    outs = ["copied.txt"],
    cmd = "cat $(SRCS) > $@",
)

genrule(
    name = "directory_consumer",
    srcs = ["@bridge//:mirror_dir"],
    outs = ["directory-child.txt"],
    cmd = "cat $(location @bridge//:mirror_dir)/child.txt > $@",
)

filegroup(name = "unrelated")
