module(
    name = "single_version_override_patch_test",
    version = "0.0.0",
)

# `dep` comes from the local registry the e2e case writes next to this file (see
# regressions.rs: the archive and its integrity are produced at test time, so no
# binary fixture is checked in). The override patches a plain data file, not a
# .bzl, so only the //external:dep node's _bazel_diff_local_inputs_hash sees the
# patch change.
bazel_dep(name = "dep", version = "1.0")
single_version_override(
    module_name = "dep",
    version = "1.0",
    patch_strip = 1,
    patches = ["//:dep.patch"],
)
