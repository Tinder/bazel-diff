module(name = "workspace_path_repository_test")

bazel_dep(name = "ext")
local_path_override(module_name = "ext", path = "ext")

# Module `ext`'s extension builds `@vendored` from `vendored/` in this workspace
# and names that directory by absolute path, as rules_rs local crates and
# Gazelle's `local_path` do. See regressions.rs.
vendored = use_extension("@ext//:vendored.bzl", "vendored")
use_repo(vendored, "vendored")
